                                        data-bgset="{{ option_image | img_url: '92x', format: 'pjpg' }})"
                                    {%- else -%}
                                        data-master="{{ option_image | img_url: '1x1' | replace: '_1x1.', '_[width]x.' }}"
                                        data-bgset="{{ option_image | img_url: '92x' }}"
                                    {%- endif -%}
                                 data-scale="2"
                                {%- if settings.tooltips_enable %}
                                    data-js-tooltip
                                    data-tippy-content="{{ value }}"
                                    data-tippy-placement="top"
                                    data-tippy-distance="6"
                                {%- endif -%}
                            ><span>{{ value }}</span></div>
                        {%- endfor -%}
                    </div>
                {%- elsif options_type_large_text contains clear_name -%}
                    <div class="product-options__section style_{{style_product}} laber-{{ option.name }} d-flex flex-wrap" data-style="large-text" data-property="{% render 'product-get-options-strip-symbols' with value, value: option.name %}"{% if disable_auto_select %} data-disable-auto-select{% endif %}>
                        {%- for value in option.values -%}
                            {% include 'product-get-options-res-status' with option_index0, option_index0: option_index0 %}
                            <div class="product-options__value product-options__value--large-text d-flex flex-center border cursor-pointer{% if disabled_value %} disabled{% endif %}{% if active_value %} active{% endif %} "
                                 data-js-option-value
                                 data-value="{% render 'product-get-options-strip-symbols' with value, value: value %}"
                                 {{ trigger_attr }}
                                 data-bg="none"
                                 data-scale="2"
                                 {%- if settings.tooltips_enable %}
                                    data-js-tooltip
                                    data-tippy-content="{{ value }}"
                                    data-tippy-placement="top"
                                    data-tippy-distance="6"
                                {%- endif -%}
                            ><span>{{ value }}</span></div>
                        {%- endfor -%}
                    </div>
                {%- elsif options_type_select contains clear_name -%}
                    <div class="select position-relative js-dropdown js-select">
                        {%- assign select_dropdown_html = '' -%}
                        <div class="dropdown-button" data-js-dropdown-button>
                            <select class="product-options__section style_{{style_product}} laber-{{ option.name }}" data-style="select" data-property="{% render 'product-get-options-strip-symbols' with value, value: option.name %}" data-js-option-select{% if disable_auto_select %} data-disable-auto-select{% endif %}>
                                {%- for value in option.values -%}
                                    {% include 'product-get-options-res-status' with option_index0, option_index0: option_index0 %}
                                    <option{% if active_value %} selected="selected"{% endif %} data-value="{% render 'product-get-options-strip-symbols' with value, value: value %}" value="{% render 'product-get-options-strip-symbols' with value, value: value %}"{% if disabled_value %} disabled="disabled"{% endif %}>{{ value }}</option>
                                    {% capture select_dropdown_html %}
                                        {{ select_dropdown_html }}
                                        <span{% if active_value %} class="selected"{% endif %} data-value="{% render 'product-get-options-strip-symbols' with value, value: value %}"{% if disabled_value %} disabled="disabled"{% endif %} {{ trigger_attr }}>{{ value }}</span>
                                    {% endcapture %}
                                {%- endfor -%}
                            </select>                            
                        </div>
                        <div class="select__dropdown dropdown d-none position-lg-absolute {% if select_dropdown_position == 'top' %}bottom{% else %}top{% endif %}-lg-100 left-lg-0" data-js-dropdown data-js-select-dropdown{% if disable_auto_select %} data-dropdown-unselected{% endif %}>
                            <div class="px-15 pb-30 py-lg-15">
                                {{ select_dropdown_html }}
                            </div>
                        </div>
                    </div>
                {%- else -%}
                    <div class="product-options__section style_{{style_product}} laber-{{ option.name }} d-flex flex-wrap" data-style="text" data-property="{% render 'product-get-options-strip-symbols' with value, value: option.name %}"{% if disable_auto_select %} data-disable-auto-select{% endif %}>
                        {%- for value in option.values -%}
                            {% include 'product-get-options-res-status' with option_index0, option_index0: option_index0 %}
                            <div class="{{ value | handleize }} product-options__value product-options__value--text  border {% if disabled_value %} disabled{% endif %}{% if active_value %} active{% endif %} "
                                 data-js-option-value
                                 data-value="{% render 'product-get-options-strip-symbols' with value, value: value %}"
                                 {{ trigger_attr }}
                                 data-bg="none"
                                 data-scale="2"
                                 
                            >{{ value }}</div>
                        {%- endfor -%}
                    </div>
                {%- endif -%}
            </div>
        {%- endfor -%}
    </div>
{%- endunless -%}
